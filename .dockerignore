# Build from source; never ship these.
node_modules/
packages/*/dist/
packages/*/tsconfig.tsbuildinfo
dist/
tsconfig.tsbuildinfo
.tmp-digest/
samples/
# the production access key: never in a build context, let alone an image
deploy/.env
.git/
.gitignore
*.log
test/e2e/shots/
test/e2e/demos/
verify-app.tmp.mjs
probe*.tmp.mjs
/tmp/carys-*.log
.DS_Store
# Local agent state, including whole worktree checkouts with their own
# node_modules — hundreds of MB the image never reads.
.claude/
# Not to be confused with .deploy/ (gitignored tunnel state): deploy/ holds
# the serve stage's nginx.conf and must stay in the context.
