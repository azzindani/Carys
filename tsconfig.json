{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "exclude": ["packages/app", "packages/ui"],
  "references": [
    { "path": "./packages/testkit" },
    { "path": "./packages/volume-core" },
    { "path": "./packages/io" },
    { "path": "./packages/render-cpu" },
    { "path": "./packages/editor-seg" },
    { "path": "./packages/measure" },
    { "path": "./packages/study" },
    { "path": "./packages/dicomweb" }
  ]
}
